      alert('최근 저장된 경기 일정 데이터가 입력창에 채워졌습니다.');
    }

    function submitMatchPlanForm() {
      const payload = {
        planyear: document.getElementById('match-plan-year').value,
        planmonth: document.getElementById('match-plan-month').value,
        plandate: document.getElementById('match-plan-date').value,
        planday: document.getElementById('match-plan-day').value,
        plantime: document.getElementById('match-plan-time').value,
        plantimeto: document.getElementById('match-plan-time-to').value,
        planawayteam: document.getElementById('match-plan-awayteam').value,
        planplace: document.getElementById('match-plan-place').value,
        planaddress: document.getElementById('navi_address').value
      };

      if (activeMatchPlanMode === 'latest') {
        updateLatestMatchPlan(payload);
        return;
      }

      createMatchPlan(payload);
    }

    function createMatchPlan(payload) {
      fetch('/match-plan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(response => {
        if (!response.ok) throw new Error('새 경기 일정 등록 실패');
        return response.json();
      })
      .then(() => {
        alert('새 경기 일정이 등록되었습니다.');
        window.location.href = '/';
      })
      .catch(error => {
        console.error(error);
        alert('새 경기 일정 등록에 실패했습니다.');
      });
    }

    function updateLatestMatchPlan(payload = {
      planyear: document.getElementById('match-plan-year').value,
      planmonth: document.getElementById('match-plan-month').value,
      plandate: document.getElementById('match-plan-date').value,
      planday: document.getElementById('match-plan-day').value,
      plantime: document.getElementById('match-plan-time').value,
      plantimeto: document.getElementById('match-plan-time-to').value,
      planawayteam: document.getElementById('match-plan-awayteam').value,
      planplace: document.getElementById('match-plan-place').value,
      planaddress: document.getElementById('navi_address').value
    }) {
      fetch('/match-plan/latest', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(response => {
        if (!response.ok) throw new Error('최근 매치 일정 수정 실패');
        return response.json();
      })
      .then(() => {
        alert('최근 매치 일정이 수정되었습니다.');
        window.location.href = '/';
      })
      .catch(error => {
        console.error(error);
        alert('최근 매치 일정 수정에 실패했습니다.');
      });
    }

