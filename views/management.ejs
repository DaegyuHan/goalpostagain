      };

      if (applyIncrement) {
        const selectedCheckboxes = document.querySelectorAll(".management-mvpboard-checkbox:checked");
        for (const checkbox of selectedCheckboxes) {
          const memberName = checkbox.value;
          const scoreInput = document.getElementById(checkbox.dataset.scoreInput);
          const currentScore = Number(scoreInput.value);

          if (scoreInput.value.trim() === '' || !Number.isFinite(currentScore)) {
            alert(`${memberName}의 점수를 숫자로 입력해주세요.`);
            return;
          }

          payload[memberName] = String(currentScore + increment);
        }
      }

      fetch('/mvpboard', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(res => res.json())
      .then(() => alert("등록되었습니다."))
      .catch(err => {
        console.error(err);
        alert("등록 실패");
      });
    }

    function UploadYoutube() {
  var fullURL = document.getElementById('inputYoutubeURL').value;
  var videoId;

  if (fullURL.startsWith('https://www.youtube.com/watch?v=')) {
    var videoIdStartIndex = fullURL.indexOf('v=') + 2;
    videoId = fullURL.substring(videoIdStartIndex);
  } else if (fullURL.startsWith('https://youtu.be/')) {
    var videoIdStartIndex = fullURL.indexOf('.be/') + 4;
    var videoIdEndIndex = fullURL.indexOf('?') !== -1 ? fullURL.indexOf('?') : fullURL.length;
    videoId = fullURL.substring(videoIdStartIndex, videoIdEndIndex);
  }

  var modifiedVideoId = videoId.replace(/&/g, '?');
  location.href = `/UploadURL?URL=${encodeURIComponent(modifiedVideoId)}`;
}


    function savePredictionSetting() {
      const homeTeam = document.getElementById('prediction-home-team').value.trim();
      const awayTeam = document.getElementById('prediction-away-team').value.trim();
      const matchTime = document.getElementById('prediction-start-time').value.trim();

      if (!homeTeam || !awayTeam || !matchTime) {
        alert('홈팀, 원정팀, 경기 시작 시간을 모두 입력해주세요.');
        return;
      }

      const payload = new FormData();
      payload.append('homeTeam', homeTeam);
      payload.append('awayTeam', awayTeam);
      payload.append('matchTime', matchTime);

      const homeLogo = document.getElementById('prediction-home-logo').files[0];
      const awayLogo = document.getElementById('prediction-away-logo').files[0];
      if (homeLogo) payload.append('homeLogo', homeLogo);
      if (awayLogo) payload.append('awayLogo', awayLogo);

      fetch('/prediction/setting', {
        method: 'POST',
        body: payload
      })
      .then((response) => response.json())
      .then((data) => {
        if (!data.ok) throw new Error(data.message || '승부예측 등록 실패');
        alert('승부예측이 등록되었습니다.');
        window.location.reload();
      })
      .catch((error) => {
        console.error(error);
        alert(error.message || '승부예측 등록에 실패했습니다.');
      });
    }

    function togglePrediction(isOpen) {
      fetch('/prediction/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ isOpen })
      })
        .then((response) => response.json())
        .then((data) => {
          if (!data.ok) throw new Error(data.message || '예측 상태 변경 실패');
          alert(isOpen ? '승부예측을 다시 열었습니다.' : '승부예측을 마감했습니다.');
          window.location.reload();
        })
        .catch((error) => alert(error.message || '예측 상태 변경에 실패했습니다.'));
    }

    function savePredictionResult() {
      const finalHomeScore = Number(document.getElementById('prediction-final-home-score').value);
      const finalAwayScore = Number(document.getElementById('prediction-final-away-score').value);

      if (!Number.isInteger(finalHomeScore) || !Number.isInteger(finalAwayScore) || finalHomeScore < 0 || finalAwayScore < 0) {
        alert('최종 결과 스코어를 올바르게 입력해주세요.');
        return;
      }

      fetch('/prediction/result', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ finalHomeScore, finalAwayScore })
      })
        .then((response) => response.json())
        .then((data) => {
          if (!data.ok) throw new Error(data.message || '최종 결과 저장 실패');
          alert(data.message || '최종 결과가 저장되었습니다.');
          window.location.reload();
        })
        .catch((error) => alert(error.message || '최종 결과 저장에 실패했습니다.'));
    }

    function deleteOnePredictionHistory(settingId) {
      if (!confirm('선택한 승부예측 이력을 삭제하시겠습니까?')) return;

      fetch('/prediction/history/delete-one', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ settingId })
      })
        .then((response) => response.json())
        .then((data) => {
          if (!data.ok) throw new Error(data.message || '예측 이력 삭제 실패');
          alert(data.message || '예측 이력을 삭제했습니다.');
          window.location.reload();
        })
        .catch((error) => alert(error.message || '예측 이력 삭제에 실패했습니다.'));
    }

    function reset_ShootingGame() {
      var confirmDelete = confirm('정말 초기화하시겠습니까?');

      if (confirmDelete) {
        fetch('/reset-shootinggame', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        })
        .then(response => {
          if (response.ok) {
            window.location.href = '/';
          }
        })
        .catch(error => console.error('Error:', error));
      }
    }

