    document.addEventListener('DOMContentLoaded', () => {
      const managementTabs = document.querySelectorAll('[data-management-tab]');
      const managementPanels = document.querySelectorAll('[data-management-panel]');
      const managementTools = document.querySelectorAll('.management-tools-item');
      const managementStats = document.querySelectorAll('.management-stats-item');

      function selectManagementTab(selectedTab) {
        managementTabs.forEach((tab) => {
          tab.classList.toggle('active', tab.dataset.managementTab === selectedTab);
        });
        managementPanels.forEach((panel) => {
          panel.classList.toggle('management-is-hidden', panel.dataset.managementPanel !== selectedTab);
        });
        managementTools.forEach((tool) => {
          tool.classList.toggle('management-is-hidden', selectedTab !== 'tools');
        });
        managementStats.forEach((stats) => {
          stats.classList.toggle('management-is-hidden', selectedTab !== 'stats');
        });
      }

      managementTabs.forEach((tab) => {
        tab.addEventListener('click', (event) => {
          event.preventDefault();
          selectManagementTab(tab.dataset.managementTab);
        });
      });

      selectManagementTab('schedule');
    });

