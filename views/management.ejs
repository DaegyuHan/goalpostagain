    function setMatchPlanMode(mode) {
      activeMatchPlanMode = mode;
      const buttons = document.querySelectorAll('[data-match-plan-mode-button]');
      buttons.forEach((button) => {
        const isActive = button.dataset.matchPlanModeButton === mode;
        button.classList.toggle('btn-primary', isActive);
        button.classList.toggle('btn-secondary', !isActive);
      });
    }

    function setResultMode(mode) {
      activeResultMode = mode;
      const buttons = document.querySelectorAll('[data-result-mode-button]');
      buttons.forEach((button) => {
        const isActive = button.dataset.resultModeButton === mode;
        button.classList.toggle('btn-primary', isActive);
        button.classList.toggle('btn-secondary', !isActive);
      });
    }

    function fillNewMatchPlanForm() {
      const currentYear = document.getElementById('match-plan-year')?.value || '';
      const currentMonth = document.getElementById('match-plan-month')?.value || '';
      const currentDate = document.getElementById('match-plan-date')?.value || '';
      const currentDay = document.getElementById('match-plan-day')?.value || '';
      const currentTime = document.getElementById('match-plan-time')?.value || '';
      const currentTimeTo = document.getElementById('match-plan-time-to')?.value || '';
      const currentAwayTeam = document.getElementById('match-plan-awayteam')?.value || '';
      const currentPlace = document.getElementById('match-plan-place')?.value || '';

      document.getElementById('match-plan-year').value = currentYear;
      document.getElementById('match-plan-month').value = currentMonth;
      document.getElementById('match-plan-date').value = currentDate;
      document.getElementById('match-plan-day').value = currentDay;
      document.getElementById('match-plan-time').value = currentTime;
      document.getElementById('match-plan-time-to').value = currentTimeTo;
      document.getElementById('match-plan-awayteam').value = currentAwayTeam;
      document.getElementById('match-plan-place').value = currentPlace;
      setMatchPlanMode('create');
      alert('새 일정 등록용 데이터가 입력창에 채워졌습니다.');
    }

    function fillLatestMatchPlanForm() {
      const values = latestMatchPlanData || {};
      document.getElementById('match-plan-year').value = values.year || '';
      document.getElementById('match-plan-month').value = values.month || '';
      document.getElementById('match-plan-date').value = values.date || '';
      document.getElementById('match-plan-day').value = values.day || '';
