    function getResultLogos(homescore, awayscore) {
      if (homescore > awayscore) {
        return {
          resultlogo: '<img src="https://ik.imagekit.io/wlalafg7g/GoalPostAgain/match%20result/%EC%8A%B9%EB%A6%AC.png?updatedAt=1702704505577" alt="win">',
          home_resultlogo: '<img class="home-lastmatch-result-logo" src="https://ik.imagekit.io/wlalafg7g/GoalPostAgain/Home/2.%20%EC%8A%B9%EB%A6%AC.png?updatedAt=1703502072480" alt="win">'
        };
      }
      if (homescore === awayscore) {
        return {
          resultlogo: '<img src="https://ik.imagekit.io/wlalafg7g/GoalPostAgain/match%20result/%EB%AC%B4%EC%8A%B9%EB%B6%80.png?updatedAt=1702704505369" alt="draw">',
          home_resultlogo: '<img class="home-lastmatch-result-logo" src="https://ik.imagekit.io/wlalafg7g/GoalPostAgain/Home/KakaoTalk_20231228_145702327.png?updatedAt=1703773523870" alt="draw">'
        };
      }
      return {
        resultlogo: '<img src="https://ik.imagekit.io/wlalafg7g/GoalPostAgain/match%20result/%ED%8C%A8%EB%B0%B0.png?updatedAt=1702704505579" alt="lose">',
        home_resultlogo: '<img class="home-lastmatch-result-logo" src="https://ik.imagekit.io/wlalafg7g/GoalPostAgain/Home/2.%20%ED%8C%A8%EB%B0%B0.png?updatedAt=1703502072486" alt="win">'
      };
    }

    function getResultPayload() {
      const homescore = Number(document.getElementById('match-result-homescore').value);
      const awayscore = Number(document.getElementById('match-result-awayscore').value);

      if (Number.isNaN(homescore) || Number.isNaN(awayscore)) {
        throw new Error('양 팀 점수는 숫자로 입력해주세요.');
      }

      const logos = getResultLogos(homescore, awayscore);
      return {
        year: document.getElementById('match-result-year').value,
        month: document.getElementById('match-result-month').value,
        day: document.getElementById('match-result-day').value,
        day2: document.getElementById('match-result-day2').value,
        time: document.getElementById('match-result-time').value,
        place: document.getElementById('match-result-place').value,
        homescore,
        awayscore,
        awayname: document.getElementById('match-result-awayname').value,
        ...logos
      };
    }

    function submitResultForm() {
      try {
        const payload = getResultPayload();
        if (activeResultMode === 'latest') {
          updateLatestResult(payload);
          return;
        }
        upload_match(payload);
      } catch (error) {
        alert(error.message || '경기 결과를 등록할 수 없습니다.');
      }
    }

    function upload_match(payload = getResultPayload()) {
      fetch('/result', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(response => {
        if (!response.ok) throw new Error('새 경기 결과 등록 실패');
        return response.json();
      })
      .then(() => {
        alert('새 경기 결과가 등록되었습니다.');
      })
      .catch(error => {
        console.error(error);
        alert('새 경기 결과 등록에 실패했습니다.');
      });
    }

    function updateLatestResult(payload = getResultPayload()) {
      fetch('/result/latest', {
