<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light only" />
  <meta name="supported-color-schemes" content="light" />
  <title>오늘도골대FC</title>
  <link rel="apple-touch-icon" sizes="180x180"
    href="https://ik.imagekit.io/wlalafg7g/GoalPostAgain/logo.png?updatedAt=1700484789437">
  <link rel="icon" type="image/png" sizes="192x192"
    href="https://ik.imagekit.io/wlalafg7g/GoalPostAgain/logo.png?updatedAt=1700484789437">
  <link rel="icon" type="image/png" sizes="512x512"
    href="https://ik.imagekit.io/wlalafg7g/GoalPostAgain/logo.png?updatedAt=1700484789437">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
  <link href="/main.css" rel="stylesheet">
  <link href="/mypage.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Hi+Melody&family=Noto+Sans+KR:wght@200;300;400;500;600&display=swap"
    rel="stylesheet">
  <script src="/main.js"></script>


</head>

<body>
  <%- include('nav.ejs') %>

    <div class="mypage-main">

      <header class="mypage-heading">
        <p class="mypage-eyebrow">MEMBER PROFILE</p>
        <div class="mypage-profile-line">
          <h1><%= 프로필유저.username %></h1>
          <% if (clubEmblems.length > 0) { %>
            <ul class="mypage-club-emblems" aria-label="좋아하는 축구 클럽">
              <% clubEmblems.forEach((clubEmblem) => { %>
                <li>
                  <img src="<%= clubEmblem.imageUrl %>" alt="<%= clubEmblem.clubName %> 엠블럼" title="<%= clubEmblem.clubName %>" loading="lazy">
                </li>
              <% }); %>
            </ul>
          <% } %>
        </div>
        <% if (memberInfo.isComplete) { %>
          <dl class="mypage-member-info">
            <% if (memberInfo.position) { %>
              <div class="mypage-member-info-row">
                <dt>포지션</dt>
                <dd><span class="mypage-position mypage-position--<%= memberInfo.position.toLowerCase() %>"><%= memberInfo.position %></span></dd>
              </div>
            <% } %>
            <% if (memberInfo.birth) { %>
              <div class="mypage-member-info-row">
                <dt>생년월일</dt>
                <dd><%= memberInfo.birth.label %> <span class="mypage-member-info-sub">(만 <%= memberInfo.birth.age %>세)</span></dd>
              </div>
            <% } %>
            <% if (memberInfo.body) { %>
              <div class="mypage-member-info-row">
                <dt>신체</dt>
                <dd><%= memberInfo.body %></dd>
              </div>
            <% } %>
            <% if (memberTraits.length > 0) { %>
              <div class="mypage-member-info-row mypage-member-info-row--traits">
                <dt>특성</dt>
                <dd>
                  <ul class="mypage-traits">
                    <% memberTraits.forEach((trait) => { %>
                      <li><img src="<%= trait.imageUrl %>" alt="<%= trait.name %>" title="<%= trait.name %>" loading="lazy"></li>
                    <% }); %>
                  </ul>
                </dd>
              </div>
            <% } %>
          </dl>
        <% } else if (isOwnProfile) { %>
          <div class="mypage-info-empty">
            <p>회원정보를 입력하면 포지션, 생년월일, 신체, 특성이 프로필에 표시돼요.</p>
            <button class="mypage-info-button" type="button" data-open-profile-info>
              <i class="fa-solid fa-user-pen" aria-hidden="true"></i>
              회원정보 입력하기
            </button>
          </div>
        <% } %>
      </header>

      <section class="mypage-badges" aria-labelledby="mypage-badges-title">
        <div class="mypage-badges-heading">
          <div>
            <h2 id="mypage-badges-title">뱃지함</h2>
            <p><%= badges.length %>개의 뱃지</p>
          </div>
        </div>
        <% if (badges.length === 0) { %>
          <p class="mypage-badges-empty">아직 받은 뱃지가 없습니다.</p>
        <% } else { %>
          <div class="mypage-badge-grid">
            <% badges.forEach((badge, index) => { %>
              <button class="mypage-badge" type="button" aria-label="뱃지 설명: <%= badge.description %>" aria-expanded="false" aria-controls="mypage-badge-caption-<%= index %>">
                <img src="<%= badge.imageUrl %>" alt="" loading="lazy">
                <span id="mypage-badge-caption-<%= index %>" class="mypage-badge-caption"><%= badge.description %></span>
              </button>
            <% }); %>
          </div>
        <% } %>
      </section>

      <section class="mypage-mvp-summary" aria-labelledby="mypage-mvp-title">
        <div>
          <h2 id="mypage-mvp-title">받은 MVP</h2>
          <p>지금까지 선정된 횟수</p>
        </div>
        <strong><%= mvpAwardCount %>회</strong>
      </section>

      <section class="mypage-activity" aria-labelledby="mypage-activity-title">
        <div class="mypage-activity-heading">
          <h2 id="mypage-activity-title">사진 활동</h2>
        </div>
        <div class="mypage-activity-grid">
          <div class="mypage-activity-stat">
            <span>작성한 사진</span>
            <strong><%= activityStats.photoPostCount %></strong>
            <small>사진 게시글</small>
          </div>
          <div class="mypage-activity-stat">
            <span>작성한 댓글</span>
            <strong><%= activityStats.commentCount %></strong>
            <small>사진 탭</small>
          </div>
          <div class="mypage-activity-stat">
            <span>좋아요한 사진</span>
            <strong><%= activityStats.likedPhotoCount %></strong>
            <small>현재 좋아요 상태</small>
          </div>
        </div>
      </section>

      <% if (isOwnProfile) { %>
      <section class="mypage-notification-settings" aria-labelledby="mypage-push-title">
        <div>
          <h2 id="mypage-push-title">웹 푸시 알림</h2>
          <p id="mypage-push-status" aria-live="polite"><%= pushEnabled ? '모든 기기에서 알림을 받고 있습니다.' : '모든 기기의 알림이 꺼져 있습니다.' %></p>
        </div>
        <div class="mypage-push-actions">
          <button id="mypage-device-push-toggle" class="mypage-push-device-button" type="button" disabled>
            <i class="fa-solid fa-mobile-screen-button" aria-hidden="true"></i>
            <span id="mypage-device-push-label">기기 상태 확인 중...</span>
          </button>
          <label class="mypage-push-switch">
            <span class="mypage-push-switch-text" aria-hidden="true">전체 알림</span>
            <span class="visually-hidden">모든 기기 웹 푸시 알림 설정</span>
            <input id="mypage-push-enabled" type="checkbox" role="switch" <%= pushEnabled ? 'checked' : '' %> onchange="togglePushNotifications(this)">
            <span class="mypage-push-slider" aria-hidden="true"></span>
          </label>
        </div>
      </section>

      <section class="mypage-profile-settings" aria-labelledby="mypage-profile-settings-title">
        <div>
          <h2 id="mypage-profile-settings-title">회원정보</h2>
          <p><%= memberInfo.isComplete ? '생년월일, 키, 몸무게를 수정할 수 있습니다.' : '아직 입력한 회원정보가 없습니다.' %></p>
        </div>
        <button class="mypage-info-button mypage-info-button--outline" type="button" data-open-profile-info>
          <i class="fa-solid fa-pen" aria-hidden="true"></i>
          <%= memberInfo.isComplete ? '회원정보 수정' : '회원정보 입력' %>
        </button>
      </section>

      <dialog id="mypage-profile-dialog" class="mypage-profile-dialog" aria-labelledby="mypage-profile-dialog-title">
        <form id="mypage-profile-form" class="mypage-profile-form" novalidate>
          <div class="mypage-profile-dialog-head">
            <h2 id="mypage-profile-dialog-title"><%= memberInfo.isComplete ? '회원정보 수정' : '회원정보 입력' %></h2>
            <button class="mypage-profile-dialog-close" type="button" data-close-profile-info aria-label="닫기">
              <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
          </div>

          <label class="mypage-profile-field">
            <span>생년월일</span>
            <input id="mypage-birth-date" name="birthDate" type="date" min="1900-01-01" max="<%= todayKey %>" value="<%= memberInfo.form.birthDate %>" required>
          </label>

          <div class="mypage-profile-field-row">
            <label class="mypage-profile-field">
              <span>키</span>
              <span class="mypage-profile-input-unit">
                <input id="mypage-height" name="heightCm" type="text" inputmode="numeric" pattern="[1-9][0-9]*" maxlength="3" placeholder="예) 175" value="<%= memberInfo.form.heightCm %>" required>
                <em>cm</em>
              </span>
            </label>
            <label class="mypage-profile-field">
              <span>몸무게</span>
              <span class="mypage-profile-input-unit">
                <input id="mypage-weight" name="weightKg" type="text" inputmode="numeric" pattern="[1-9][0-9]*" maxlength="3" placeholder="예) 70" value="<%= memberInfo.form.weightKg %>" required>
                <em>kg</em>
              </span>
            </label>
          </div>
          <p class="mypage-profile-hint">키와 몸무게는 자연수(소수점 없이)로 입력해주세요.</p>
          <p id="mypage-profile-error" class="mypage-profile-error" role="alert"></p>

          <div class="mypage-profile-actions">
            <button class="mypage-info-button mypage-info-button--ghost" type="button" data-close-profile-info>취소</button>
            <button id="mypage-profile-submit" class="mypage-info-button" type="submit">저장</button>
          </div>
        </form>
      </dialog>
      <% } %>

    </div>

  <%- include('footer.ejs') %>
  <script>
    const devicePushButton = document.getElementById('mypage-device-push-toggle');
    const devicePushLabel = document.getElementById('mypage-device-push-label');
    const devicePushIcon = devicePushButton?.querySelector('i');
    const accountPushToggle = document.getElementById('mypage-push-enabled');
      const status = document.getElementById('mypage-push-status');

    async function syncDevicePushButton() {
      if (!devicePushButton) return;
      if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
        devicePushLabel.textContent = '이 브라우저는 미지원';
        devicePushButton.disabled = true;
        return null;
      }

      try {
        const registration = await navigator.serviceWorker.ready;
        const subscription = await registration.pushManager.getSubscription();
        const isSubscribed = Boolean(subscription);
        devicePushButton.dataset.subscribed = String(isSubscribed);
        devicePushLabel.textContent = isSubscribed ? '이 기기 구독 해제' : '이 기기에서도 받기';
        devicePushIcon.className = isSubscribed
          ? 'fa-solid fa-bell-slash'
          : 'fa-solid fa-mobile-screen-button';
        devicePushButton.disabled = false;
        return subscription;
      } catch (error) {
        devicePushLabel.textContent = '기기 상태 확인 실패';
        devicePushButton.disabled = false;
        throw error;
      }
    }

    void syncDevicePushButton().catch((error) => {
      console.error('Current device push status failed:', error);
    });

    devicePushButton?.addEventListener('click', async () => {
      devicePushButton.disabled = true;
      const wasSubscribed = devicePushButton.dataset.subscribed === 'true';
      status.textContent = wasSubscribed ? '이 기기 구독을 해제하는 중...' : '이 기기를 등록하는 중...';

      try {
        const registration = await navigator.serviceWorker.ready;
        const subscription = await registration.pushManager.getSubscription();
        if (subscription) {
          const response = await fetch('/push/subscribe', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ endpoint: subscription.endpoint })
          });
          const data = await response.json();
          if (!response.ok || !data.ok) throw new Error(data.message || '이 기기 구독을 해제하지 못했습니다.');
          await subscription.unsubscribe();
          status.textContent = '이 기기의 구독을 해제했습니다. 다른 기기 설정은 유지됩니다.';
        } else {
          await enablePushNotifications();
          accountPushToggle.checked = true;
          status.textContent = '이 기기를 알림 수신 기기로 등록했습니다.';
        }
      } catch (error) {
        status.textContent = error.message || '기기 알림 설정을 변경하지 못했습니다.';
      } finally {
        try {
          await syncDevicePushButton();
        } catch (error) {
          console.error('Current device push status refresh failed:', error);
        }
      }
    });

    // 회원정보 입력/수정 팝업
    const profileDialog = document.getElementById('mypage-profile-dialog');
    const profileForm = document.getElementById('mypage-profile-form');
    const profileError = document.getElementById('mypage-profile-error');
    const profileSubmit = document.getElementById('mypage-profile-submit');
    const MAX_BODY_VALUE = 300;

    document.querySelectorAll('[data-open-profile-info]').forEach((button) => {
      button.addEventListener('click', () => {
        profileError.textContent = '';
        profileDialog?.showModal();
      });
    });
    document.querySelectorAll('[data-close-profile-info]').forEach((button) => {
      button.addEventListener('click', () => profileDialog?.close());
    });
    // 팝업 바깥(어두운 배경) 클릭 시 닫기
    profileDialog?.addEventListener('click', (event) => {
      if (event.target === profileDialog) profileDialog.close();
    });

    // 키·몸무게: 숫자 외 입력은 즉시 제거하고, 맨 앞의 0도 지움
    ['mypage-height', 'mypage-weight'].forEach((id) => {
      const input = document.getElementById(id);
      input?.addEventListener('input', () => {
        input.value = input.value.replace(/\D/g, '').replace(/^0+/, '').slice(0, 3);
      });
    });

    function isNaturalNumber(value) {
      return /^[1-9]\d*$/.test(value) && Number(value) <= MAX_BODY_VALUE;
    }

    profileForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const birthDate = profileForm.birthDate.value;
      const heightCm = profileForm.heightCm.value.trim();
      const weightKg = profileForm.weightKg.value.trim();

      if (!birthDate || birthDate < profileForm.birthDate.min || birthDate > profileForm.birthDate.max) {
        profileError.textContent = '생년월일을 올바르게 입력해주세요.';
        return;
      }
      if (!isNaturalNumber(heightCm) || !isNaturalNumber(weightKg)) {
        profileError.textContent = `키와 몸무게는 1~${MAX_BODY_VALUE} 사이의 자연수로 입력해주세요.`;
        return;
      }

      profileSubmit.disabled = true;
      profileError.textContent = '';
      try {
        const response = await fetch('/mypage/profile-info', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ birthDate, heightCm, weightKg })
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.ok) throw new Error(data.message || '회원정보를 저장하지 못했습니다.');
        location.reload();
      } catch (error) {
        profileError.textContent = error.message;
        profileSubmit.disabled = false;
      }
    });

    document.querySelectorAll('.mypage-badge').forEach((badge) => {
      badge.addEventListener('click', () => {
        const isExpanded = badge.getAttribute('aria-expanded') === 'true';
        badge.setAttribute('aria-expanded', String(!isExpanded));
        badge.classList.toggle('is-revealed', !isExpanded);
      });
    });
  </script>
</body>

</html>