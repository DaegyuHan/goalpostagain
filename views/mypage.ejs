<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light only" />
  <meta name="supported-color-schemes" content="light" />
  <title>오늘도골대FC</title>
  <link rel="apple-touch-icon" sizes="180x180"
    href="https://ik.imagekit.io/wlalafg7g/GoalPostAgain/logo.png?updatedAt=1700484789437">
  <link rel="icon" type="image/png" sizes="192x192"
    href="https://ik.imagekit.io/wlalafg7g/GoalPostAgain/logo.png?updatedAt=1700484789437">
  <link rel="icon" type="image/png" sizes="512x512"
    href="https://ik.imagekit.io/wlalafg7g/GoalPostAgain/logo.png?updatedAt=1700484789437">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
  <link href="/main.css" rel="stylesheet">
  <link href="/mypage.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Hi+Melody&family=Noto+Sans+KR:wght@200;300;400;500;600&display=swap"
    rel="stylesheet">
  <script src="/main.js"></script>


</head>

<body>
  <%- include('nav.ejs') %>

    <div class="mypage-main">

      <header class="mypage-heading">
        <p class="mypage-eyebrow">MEMBER PROFILE</p>
        <h1><%= 유저.username %><span>님의 페이지</span></h1>
      </header>

      <section class="mypage-badges" aria-labelledby="mypage-badges-title">
        <div class="mypage-badges-heading">
          <div>
            <h2 id="mypage-badges-title">뱃지함</h2>
            <p><%= badges.length %>개의 뱃지</p>
          </div>
        </div>
        <% if (badges.length === 0) { %>
          <p class="mypage-badges-empty">아직 받은 뱃지가 없습니다.</p>
        <% } else { %>
          <div class="mypage-badge-grid">
            <% badges.forEach((badge, index) => { %>
              <button class="mypage-badge" type="button" aria-label="뱃지 설명: <%= badge.description %>" aria-expanded="false" aria-controls="mypage-badge-caption-<%= index %>">
                <img src="<%= badge.imageUrl %>" alt="" loading="lazy">
                <span id="mypage-badge-caption-<%= index %>" class="mypage-badge-caption"><%= badge.description %></span>
              </button>
            <% }); %>
          </div>
        <% } %>
      </section>

      <section class="mypage-mvp-summary" aria-labelledby="mypage-mvp-title">
        <div>
          <h2 id="mypage-mvp-title">받은 MVP</h2>
          <p>지금까지 선정된 횟수</p>
        </div>
        <strong><%= mvpAwardCount %>회</strong>
      </section>

      <section class="mypage-activity" aria-labelledby="mypage-activity-title">
        <div class="mypage-activity-heading">
          <h2 id="mypage-activity-title">사진 활동</h2>
        </div>
        <div class="mypage-activity-grid">
          <div class="mypage-activity-stat">
            <span>작성한 사진</span>
            <strong><%= activityStats.photoPostCount %></strong>
            <small>사진 게시글</small>
          </div>
          <div class="mypage-activity-stat">
            <span>작성한 댓글</span>
            <strong><%= activityStats.commentCount %></strong>
            <small>사진 탭</small>
          </div>
          <div class="mypage-activity-stat">
            <span>좋아요한 사진</span>
            <strong><%= activityStats.likedPhotoCount %></strong>
            <small>현재 좋아요 상태</small>
          </div>
        </div>
      </section>

      <section class="mypage-notification-settings" aria-labelledby="mypage-push-title">
        <div>
          <h2 id="mypage-push-title">웹 푸시 알림</h2>
          <p id="mypage-push-status" aria-live="polite"><%= pushEnabled ? '알림을 받고 있습니다.' : '알림이 꺼져 있습니다.' %></p>
        </div>
        <label class="mypage-push-switch">
          <span class="visually-hidden">웹 푸시 알림 설정</span>
          <input type="checkbox" role="switch" <%= pushEnabled ? 'checked' : '' %> onchange="togglePushNotifications(this)">
          <span class="mypage-push-slider" aria-hidden="true"></span>
        </label>
      </section>

 

    </div>

  <%- include('footer.ejs') %>
  <script>
    document.querySelectorAll('.mypage-badge').forEach((badge) => {
      badge.addEventListener('click', () => {
        const isExpanded = badge.getAttribute('aria-expanded') === 'true';
        badge.setAttribute('aria-expanded', String(!isExpanded));
        badge.classList.toggle('is-revealed', !isExpanded);
      });
    });
  </script>
</body>

</html>